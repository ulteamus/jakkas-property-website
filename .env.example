# Jakkash Property Broker — environment template
# Copy to `.env` at repo root. Never commit real secrets.
# Keys match config.py / database/db.py / services/* (audited 2026-08-27).
# Conceptual aliases in comments only — do not rename keys without code changes.

# =============================================================================
# Flask core
# =============================================================================
# Flask CLI entry (optional): flask --app app run
FLASK_APP=app.py
FLASK_SECRET_KEY=generate-a-long-random-secret-key
FLASK_DEBUG=0
# development | production — production blocks unsafe SQLite fallback / OTP defaults
FLASK_ENV=development
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

# =============================================================================
# Database
# Priority when configured:
#   1) SUPABASE_DB_URL (PostgreSQL) — set USE_SQLITE=0
#   2) MYSQL_* when USE_SQLITE=0 and no Postgres URL
#   3) SQLite when USE_SQLITE=1 (local default)
# =============================================================================
USE_SQLITE=1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=jakkash_property

# --- Supabase Postgres (production / hosted) ---
# Dashboard → Project Settings → Database → Connection string (URI)
# SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=
# USE_SUPABASE_DB=1

# =============================================================================
# Admin bootstrap
# =============================================================================
DEFAULT_ADMIN_PASSWORD=change-me-on-first-login

# =============================================================================
# Company (public site)
# =============================================================================
COMPANY_EMAIL=Jakkashproperty@gmail.com
COMPANY_ADDRESS=40,Ganesh Krupa Soc,Opp Gail Tower ,Anand Mahal Road ,Surat 395009
COMPANY_WHATSAPP=918511751119
COMPANY_YEARS_EXPERIENCE=10

# =============================================================================
# Media storage
# STORAGE_BACKEND=supabase | cloudinary | local | auto (empty = auto)
# =============================================================================
STORAGE_BACKEND=supabase

# --- Supabase API + Storage ---
# Dashboard → Project Settings → API
#   Project URL  → SUPABASE_URL
#   service_role → SUPABASE_KEY (preferred for server uploads) or SUPABASE_SERVICE_KEY
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_KEY=<your-anon-or-service-role-key>
SUPABASE_SERVICE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=property-media
SUPABASE_BUCKET=property-media

# --- Cloudinary (optional secondary) ---
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =============================================================================
# OTP & SMS
# SMS_PROVIDER=twilio requires TWILIO_*. For local admin login without SMS,
# leave Twilio empty and set ALLOW_DEV_OTP_FALLBACK=1 (dev only).
# "mock" is not a separate provider — empty Twilio + fallback acts as mock.
# =============================================================================
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALLOW_DEV_OTP_FALLBACK=1

# =============================================================================
# Platform / deploy
# VERCEL is set by the host; leave unset locally. Do not invent VERCEL=false
# as a string unless you know a check expects it (code uses presence of VERCEL).
# =============================================================================
# VERCEL=1
# VERCEL_ASSET_ROOT=
