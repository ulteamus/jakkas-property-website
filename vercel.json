{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "static/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": "{static/property-uploads/**,public/**,api/static/**,ml/**,**/*.mp4,**/*.pkl}"
      }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/uploads/(.*)", "dest": "/static/property-uploads/$1" },
    { "src": "/(.*)", "dest": "api/index.py" }
  ]
}
